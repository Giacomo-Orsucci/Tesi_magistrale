\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces The equivalent geometric representations of a Unit Disk Graph (UDG) adapted from \cite  {CLARK1990165}. \textbf  {(a)} The Distance Model connects nodes $u$ and $v$ if their Euclidean distance is $d \leq r$. \textbf  {(b)} The Intersection Model places a disk of radius $r/2$ centered on each node; edges are formed exclusively where disks overlap.}}{17}{figure.2.1}\protected@file@percent }
\newlabel{fig:udg_models}{{2.1}{17}{The equivalent geometric representations of a Unit Disk Graph (UDG) adapted from \cite {CLARK1990165}. \textbf {(a)} The Distance Model connects nodes $u$ and $v$ if their Euclidean distance is $d \leq r$. \textbf {(b)} The Intersection Model places a disk of radius $r/2$ centered on each node; edges are formed exclusively where disks overlap}{figure.2.1}{}}
\citation{CLARK1990165}
\citation{Henriet2020quantumcomputing}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Physical realization of the Maximum Independent Set (MIS) via the Rydberg blockade. Red dots represent atoms excited to the Rydberg state (\textbf  {MIS selected nodes}), while black dots are atoms remained in the ground state (\textbf  {unselected nodes}). The shaded red regions represent the Rydberg blockade volume (radius $R_b$). The physical mechanism preventing two Rydberg excitations from overlapping perfectly enforces the mathematical constraint of the MIS problem.}}{19}{figure.2.2}\protected@file@percent }
\newlabel{fig:rydberg_mis}{{2.2}{19}{Physical realization of the Maximum Independent Set (MIS) via the Rydberg blockade. Red dots represent atoms excited to the Rydberg state (\textbf {MIS selected nodes}), while black dots are atoms remained in the ground state (\textbf {unselected nodes}). The shaded red regions represent the Rydberg blockade volume (radius $R_b$). The physical mechanism preventing two Rydberg excitations from overlapping perfectly enforces the mathematical constraint of the MIS problem}{figure.2.2}{}}
