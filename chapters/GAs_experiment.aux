\@writefile{toc}{\contentsline {section}{\numberline {4.5}Algorithmic Breakdown: A 15x15 Instance}{62}{section.4.5}\protected@file@percent }
\newlabel{sec:15x15_GA}{{4.5}{62}{Algorithmic Breakdown: A 15x15 Instance}{section.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces Structure of the $15 \times 15$ UDG-like QUBO instance generated via \textit  {instance\_generator.py}, inspected using \textit  {inspect\_qubo.py}, and subsequently embedded using the \textit  {bench-GA.py} module \cite  {orsucci_qubo_ga_quantum}.}}{62}{figure.4.13}\protected@file@percent }
\newlabel{fig:15x15_qubo_instance}{{4.13}{62}{Structure of the $15 \times 15$ UDG-like QUBO instance generated via \textit {instance\_generator.py}, inspected using \textit {inspect\_qubo.py}, and subsequently embedded using the \textit {bench-GA.py} module \cite {orsucci_qubo_ga_quantum}}{figure.4.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.4}{\ignorespaces Heavy-duty hyperparameter configuration required to attempt the embedding of a $15 \times 15$ QUBO instance. The parametrization clearly highlights the algorithmic struggle against the curse of dimensionality: a massive computational effort (population and generations) is heavily bottlenecked by extreme selection pressure and microscopic mutation rates to prevent the destruction of highly dense layouts. Values are compared against the $5 \times 5$ baseline from Table \ref  {tab:pygad_parameters_5x5}.}}{63}{table.4.4}\protected@file@percent }
\newlabel{tab:pygad_15x15_parameters}{{4.4}{63}{Heavy-duty hyperparameter configuration required to attempt the embedding of a $15 \times 15$ QUBO instance. The parametrization clearly highlights the algorithmic struggle against the curse of dimensionality: a massive computational effort (population and generations) is heavily bottlenecked by extreme selection pressure and microscopic mutation rates to prevent the destruction of highly dense layouts. Values are compared against the $5 \times 5$ baseline from Table \ref {tab:pygad_parameters_5x5}}{table.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.14}{\ignorespaces The 2D physical spatial layout generated by the Genetic Algorithm for the $N=15$ instance. The register fully complies with Neutral Atom QPU geometric boundaries.}}{64}{figure.4.14}\protected@file@percent }
\newlabel{fig:15x15_register}{{4.14}{64}{The 2D physical spatial layout generated by the Genetic Algorithm for the $N=15$ instance. The register fully complies with Neutral Atom QPU geometric boundaries}{figure.4.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces Probability distribution of the measured bitstrings after the adiabatic execution. The analog system fails to identify a valid ground state or a dominant probability mass, confirming the complete breakdown of the spatial embedding.}}{65}{figure.4.15}\protected@file@percent }
\newlabel{fig:15x15_quantum_res}{{4.15}{65}{Probability distribution of the measured bitstrings after the adiabatic execution. The analog system fails to identify a valid ground state or a dominant probability mass, confirming the complete breakdown of the spatial embedding}{figure.4.15}{}}
